SUPABASE_URL=###
SUPABASE_KEY=###
# Service-role key — server-only. Used to mint menu-photo signed upload URLs and
# remove objects (Storage does not honor the user JWT for RLS in this project).
SUPABASE_SERVICE_ROLE_KEY=###
# Sentry: build-time only, used to upload source maps (org auth token from
# sentry.io → Settings → Auth Tokens). Optional — without it uploads are skipped.
SENTRY_AUTH_TOKEN=###
