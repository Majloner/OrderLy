# Integration-test environment. Copy to `.env.test` (gitignored) and fill the
# keys from `npx supabase status` after `npx supabase start`.
#
# These point at the LOCAL Supabase stack — never a hosted/linked project. The
# integration harness seeds and deletes tenants, so it must own the database.
#
# IMPORTANT — use the JWT-format keys (they start with `eyJ`), NOT the newer
# `sb_publishable_…` / `sb_secret_…` keys. The harness seeds companies through the
# GoTrue admin API (auth.admin.createUser), which only accepts a service_role JWT;
# an `sb_secret_…` key fails with "This endpoint requires a valid Bearer token".
# The easiest source is `npx supabase status -o env` → `ANON_KEY` and
# `SERVICE_ROLE_KEY` (both `eyJ…`).

# Local API URL (default port from supabase/config.toml [api] port = 54321).
SUPABASE_URL=http://127.0.0.1:54321

# Local anon key — the `eyJ…` (JWT) "anon key" / `ANON_KEY`, not `sb_publishable_…`.
SUPABASE_KEY=

# Local service-role key — the `eyJ…` (JWT) "service_role key" / `SERVICE_ROLE_KEY`,
# not `sb_secret_…`. Used only to seed/clean fixtures and verify effects in the DB;
# never shipped to the client.
SUPABASE_SERVICE_ROLE_KEY=
