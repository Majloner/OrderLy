# E2E (Playwright) environment. Copy to `.env.e2e` (gitignored) and fill in.
#
# The E2E suite runs against the dev server (`npm run dev`), which reads its
# Supabase project from `.dev.vars` — the owner account below must exist in
# THAT project, not in the local integration stack from `.env.test`.

# Owner account the auth.setup.ts project signs in with (storageState).
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=

# Where the dev server listens; override only if you changed the port.
# E2E_BASE_URL=http://localhost:4321

# Optional one-time provisioning: set E2E_PROVISION=1 and the setup project will
# create the owner (and its company, via the handle_new_user trigger) through the
# GoTrue admin API before signing in. Requires the SERVICE ROLE key of the SAME
# Supabase project the dev server uses. Safe to leave on — "already registered"
# counts as success.
# E2E_PROVISION=1
# E2E_SUPABASE_URL=
# E2E_SUPABASE_SERVICE_ROLE_KEY=
# E2E_COMPANY_NAME=E2E Lokal

# Second tenant for cross-tenant specs (test-plan risk #1). Shares
# E2E_OWNER_PASSWORD; defaults shown below are used when unset.
# E2E_OWNER_B_EMAIL=e2e-owner-b@orderly.test
# E2E_COMPANY_B_NAME=E2E Lokal B

# Visual review (test-plan §3 Phase 4): `npm run seed:visual` resets the owner's
# tenant to a FIXED fixture (deterministic screenshots) and needs the service
# role key of the SAME project the dev server uses; `npm run test:visual` then
# captures /dashboard, /menu, /room into visual-review/screens/. The seed
# creates the owner if missing, so E2E_PROVISION is not required for this path.
# E2E_SUPABASE_URL and E2E_SUPABASE_SERVICE_ROLE_KEY are shared with the
# provisioning block above.
