@@ -0,0 +1,41 @@
+import { describe, expect, it } from "vitest";
+import { authedFetch, seedMenuItem, cleanupMenuItem } from "./helpers";
+
+describe("PATCH /api/menu-items/:id/price", () => {
+  it("rejects anonymous callers with 401", async () => {
+    const res = await fetch(`/api/menu-items/00000000-0000-0000-0000-000000000000/price`, {
+      method: "PATCH",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ price: 12 }),
+    });
+    expect(res.status).toBe(401);
+  });
+
+  it("rejects an invalid price with 400", async () => {
+    const item = await seedMenuItem({ suffix: Date.now() });
+    try {
+      const res = await authedFetch(`/api/menu-items/${item.id}/price`, { price: -5 });
+      expect(res.status).toBe(400);
+    } finally {
+      await cleanupMenuItem(item.id);
+    }
+  });
+
+  it("returns 404 for another tenant's item", async () => {
+    const foreign = await seedMenuItem({ suffix: Date.now(), company: "other" });
+    try {
+      const res = await authedFetch(`/api/menu-items/${foreign.id}/price`, { price: 12 });
+      expect(res.status).toBe(404);
+    } finally {
+      await cleanupMenuItem(foreign.id);
+    }
+  });
+
+  it("updates the price for the owning tenant", async () => {
+    const item = await seedMenuItem({ suffix: Date.now() });
+    try {
+      const res = await authedFetch(`/api/menu-items/${item.id}/price`, { price: 19.5 });
+      expect(res.status).toBe(200);
+      expect((await res.json()).price).toBe(19.5);
+    } finally {
+      await cleanupMenuItem(item.id);
+    }
+  });
+});
