+import type { APIRoute } from "astro";
+import { z } from "zod";
+import { createSupabaseServerClient } from "@/lib/supabase";
+
+export const prerender = false;
+
+const paramsSchema = z.object({ id: z.string().uuid() });
+const bodySchema = z.object({ price: z.number().positive().max(10_000) });
+
+export const PATCH: APIRoute = async ({ params, request, locals, cookies }) => {
+  const user = locals.user;
+  if (!user) {
+    return new Response(JSON.stringify({ error: "Unauthorized" }), { status: 401 });
+  }
+
+  const parsedParams = paramsSchema.safeParse(params);
+  if (!parsedParams.success) {
+    return new Response(JSON.stringify({ error: "Invalid menu item id" }), { status: 400 });
+  }
+
+  let parsedBody;
+  try {
+    parsedBody = bodySchema.safeParse(await request.json());
+  } catch {
+    return new Response(JSON.stringify({ error: "Invalid JSON body" }), { status: 400 });
+  }
+  if (!parsedBody.success) {
+    return new Response(JSON.stringify({ error: "Invalid price" }), { status: 400 });
+  }
+
+  const supabase = createSupabaseServerClient({ headers: request.headers, cookies });
+  const { data, error } = await supabase
+    .from("menu_items")
+    .update({ price: parsedBody.data.price })
+    .eq("id", parsedParams.data.id)
+    .eq("company_id", user.companyId)
+    .select()
+    .maybeSingle();
+
+  if (error) {
+    console.error("menu item price update failed", { code: error.code });
+    return new Response(JSON.stringify({ error: "Internal server error" }), { status: 500 });
+  }
+  if (!data) {
+    return new Response(JSON.stringify({ error: "Menu item not found" }), { status: 404 });
+  }
+
+  return new Response(JSON.stringify(data), { status: 200 });
+};
