{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orderly",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // Astro sessions (auto-enabled by @astrojs/cloudflare) need a SESSION KV
  // binding. Declared explicitly here so deploy uses this existing namespace
  // instead of relying on auto-provisioning, which fails in Workers Builds CI.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "bf6045cdb6a84649a840513a673bc868",
      "preview_id": "bf6045cdb6a84649a840513a673bc868",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
