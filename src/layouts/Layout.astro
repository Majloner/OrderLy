---
import "@fontsource-variable/bricolage-grotesque";
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";

interface Props {
  title?: string;
}

const { title = "10x Astro Starter" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <script>
      // Sentry client init. @sentry/astro registers this via injectScript("page")
      // (the astro:scripts/page.js module exists), but Astro 6 dev never renders
      // that script tag into pages — so import the config explicitly. ES modules
      // are singletons, so a working injection would not double-init.
      import "../../sentry.client.config.js";
    </script>
  </head>
  <body>
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <slot />
  </body>
</html>

<style>
  html {
    /* Single light theme: keep native scrollbars, autofill and pickers light. */
    color-scheme: light;
  }
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
