---
// display_name, not user.email: staff authenticate under a synthetic
// …@code.staff.orderly.invalid address that must never be shown back to them.
// This bar renders on `/`, which is exactly where sign-in redirects.
const { user, display_name } = Astro.locals;
---

<div
  class="border-border bg-card text-muted-foreground mb-4 flex items-center justify-between rounded-xl border px-4 py-2 text-sm"
>
  {
    user ? (
      <>
        <span class="text-muted-foreground">{display_name ?? user.email}</span>
        <div class="flex items-center gap-3">
          <a href="/dashboard" class="text-primary hover:text-bottle-deep transition-colors hover:underline">
            Dashboard
          </a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-primary hover:text-bottle-deep transition-colors hover:underline">
              Sign out
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="text-muted-foreground">Not signed in</span>
        <div class="flex gap-3">
          <a href="/auth/signin" class="text-primary hover:text-bottle-deep transition-colors hover:underline">
            Sign in
          </a>
          <a href="/auth/signup" class="text-primary hover:text-bottle-deep transition-colors hover:underline">
            Sign up
          </a>
        </div>
      </>
    )
  }
</div>
