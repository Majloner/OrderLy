---
import Layout from "@/layouts/Layout.astro";

// display_name, not user.email — staff sign in under a synthetic address.
const { user, role, display_name } = Astro.locals;
const isOwner = role === "owner";
---

<Layout title="Panel">
  <div class="bg-background flex min-h-screen items-center justify-center p-4">
    <div class="border-border bg-card text-foreground rounded-2xl border p-8 text-center shadow-sm">
      <h1 class="font-display text-primary mb-4 text-3xl font-bold">Panel</h1>
      <p class="text-muted-foreground">
        Witaj, <span class="text-foreground font-semibold">{display_name ?? user?.email}</span>
      </p>
      <p class="text-muted-foreground mt-2 text-sm">Ta strona jest tylko dla zalogowanych.</p>
      <div class="mt-6 flex justify-center gap-3">
        {
          isOwner && (
            <a
              href="/menu"
              class="border-border bg-card hover:bg-muted inline-block rounded-lg border px-4 py-2 text-sm transition-colors"
            >
              Menu
            </a>
          )
        }
        {
          isOwner && (
            <a
              href="/staff"
              class="border-border bg-card hover:bg-muted inline-block rounded-lg border px-4 py-2 text-sm transition-colors"
            >
              Pracownicy
            </a>
          )
        }
        {
          isOwner && (
            <a
              href="/room"
              class="border-border bg-card hover:bg-muted inline-block rounded-lg border px-4 py-2 text-sm transition-colors"
            >
              Schemat sali
            </a>
          )
        }
        <a
          href="/settings"
          class="border-border bg-card hover:bg-muted inline-block rounded-lg border px-4 py-2 text-sm transition-colors"
        >
          Ustawienia lokalu
        </a>
      </div>
      <form method="POST" action="/api/auth/signout" class="mt-4">
        <button
          type="submit"
          class="border-border bg-card hover:bg-muted rounded-lg border px-4 py-2 text-sm transition-colors"
        >
          Wyloguj
        </button>
      </form>
    </div>
  </div>
</Layout>
