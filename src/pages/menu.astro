---
import Layout from "@/layouts/Layout.astro";
import MenuManager from "@/components/menu/MenuManager";
import { SUPABASE_URL } from "astro:env/server";

// Auth + owner role are enforced by middleware (PROTECTED_ROUTES/OWNER_ROUTES),
// so this page only renders the island; it fetches GET /api/menu on mount.
// SUPABASE_URL (the public project URL, not a secret) is passed so the island
// can build public photo CDN URLs; photo uploads go through the API.
---

<Layout title="Menu lokalu">
  <div class="bg-background text-foreground min-h-screen p-4 sm:p-8">
    <div class="mx-auto w-full max-w-3xl">
      <div class="mb-6 flex items-center justify-between">
        <h1 class="font-display text-primary text-3xl font-bold">Menu lokalu</h1>
        <a href="/dashboard" class="text-primary hover:text-bottle-deep text-sm hover:underline">← Powrót do panelu</a>
      </div>
      <MenuManager client:load supabaseUrl={SUPABASE_URL ?? ""} />
    </div>
  </div>
</Layout>
