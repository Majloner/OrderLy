---
import Layout from "@/layouts/Layout.astro";
import AuthCard from "@/components/auth/AuthCard.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      heading: "Rejestracja udana",
      description: "Twoje konto zostało utworzone. Możesz się teraz zalogować.",
      linkText: "Przejdź do logowania",
    }
  : {
      emoji: "📧",
      heading: "Sprawdź e-mail",
      description: "Wysłaliśmy link potwierdzający na Twój adres e-mail. Kliknij go, aby aktywować konto.",
      linkText: "Powrót do logowania",
    };
---

<Layout title={content.heading}>
  <AuthCard title={content.heading} centered>
    <div slot="above" class="mb-4 text-5xl">{content.emoji}</div>
    <p class="text-muted-foreground mb-6">{content.description}</p>
    <a href="/auth/signin" class="text-primary hover:text-bottle-deep text-sm hover:underline">
      {content.linkText}
    </a>
  </AuthCard>
</Layout>
