---
import Layout from "@/layouts/Layout.astro";
import AuthCard from "@/components/auth/AuthCard.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Logowanie">
  <AuthCard title="Logowanie">
    <SignInForm serverError={error} client:load />
    <p class="mt-4 text-center text-sm text-blue-100/60">
      Nie masz konta? <a href="/auth/signup" class="text-purple-300 hover:underline">Zarejestruj się</a>
    </p>
  </AuthCard>
</Layout>
