---
import Layout from "@/layouts/Layout.astro";
import AuthCard from "@/components/auth/AuthCard.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Logowanie">
  <AuthCard title="Logowanie">
    <SignInForm serverError={error} client:load />
    <p class="text-muted-foreground mt-4 text-center text-sm">
      Nie masz konta? <a href="/auth/signup" class="text-primary hover:text-bottle-deep hover:underline"
        >Zarejestruj się</a
      >
    </p>
  </AuthCard>
</Layout>
