---
import Layout from "@/layouts/Layout.astro";
import AuthCard from "@/components/auth/AuthCard.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Rejestracja">
  <AuthCard title="Rejestracja">
    <SignUpForm serverError={error} client:load />
    <p class="mt-4 text-center text-sm text-blue-100/60">
      Masz już konto? <a href="/auth/signin" class="text-purple-300 hover:underline">Zaloguj się</a>
    </p>
  </AuthCard>
</Layout>
