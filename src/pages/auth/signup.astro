---
import Layout from "@/layouts/Layout.astro";
import AuthCard from "@/components/auth/AuthCard.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Rejestracja">
  <AuthCard title="Rejestracja">
    <SignUpForm serverError={error} client:load />
    <p class="text-muted-foreground mt-4 text-center text-sm">
      Masz już konto? <a href="/auth/signin" class="text-primary hover:text-bottle-deep hover:underline">Zaloguj się</a>
    </p>
  </AuthCard>
</Layout>
