---
import Layout from "@/layouts/Layout.astro";
import { Input } from "@/components/ui/input";
import { createClient } from "@/lib/supabase";

// Authentication is enforced by middleware (PROTECTED_ROUTES includes /settings),
// so `user` is guaranteed here. We only resolve owner + company context to render
// the form. (No top-level `return` in frontmatter — it trips an eslint/astro bug.)
const { company_id, role } = Astro.locals;
const isOwner = role === "owner" && Boolean(company_id);

const supabase = createClient(Astro.request.headers, Astro.cookies);
let company: { name: string; address: string | null; opening_hours: string | null } | null = null;
if (isOwner && supabase && company_id) {
  const { data } = await supabase
    .from("companies")
    .select("name, address, opening_hours")
    .eq("id", company_id)
    .maybeSingle<{ name: string; address: string | null; opening_hours: string | null }>();
  company = data;
}

const error = Astro.url.searchParams.get("error");
const success = Astro.url.searchParams.get("success");
---

<Layout title="Ustawienia lokalu">
  <div class="bg-background flex min-h-screen items-center justify-center p-4">
    <div class="border-border bg-card text-foreground w-full max-w-md rounded-2xl border p-8 shadow-sm">
      <h1 class="font-display text-primary mb-6 text-2xl font-bold">Ustawienia lokalu</h1>

      {
        isOwner ? (
          <div>
            {success && (
              <p class="border-success-border bg-success-fill text-success-fg mb-4 rounded-lg border px-3 py-2 text-sm">
                Zapisano zmiany.
              </p>
            )}
            {error && (
              <p class="border-destructive/30 bg-destructive/10 text-destructive mb-4 rounded-lg border px-3 py-2 text-sm">
                {error}
              </p>
            )}

            <form method="POST" action="/api/company/profile" class="space-y-4">
              <div>
                <label for="company-name" class="text-muted-foreground block text-sm">
                  Nazwa lokalu
                </label>
                <Input
                  id="company-name"
                  className="mt-1"
                  name="name"
                  value={company?.name ?? ""}
                  placeholder="np. Bistro Roma"
                  required
                />
              </div>
              <div>
                <label for="company-address" class="text-muted-foreground block text-sm">
                  Adres
                </label>
                <Input
                  id="company-address"
                  className="mt-1"
                  name="address"
                  value={company?.address ?? ""}
                  placeholder="ul. Przykładowa 1"
                />
              </div>
              <div>
                <label for="company-opening-hours" class="text-muted-foreground block text-sm">
                  Godziny otwarcia
                </label>
                <Input
                  id="company-opening-hours"
                  className="mt-1"
                  name="opening_hours"
                  value={company?.opening_hours ?? ""}
                  placeholder="Pon–Nd 10:00–22:00"
                />
              </div>
              <button
                type="submit"
                class="hover:bg-bottle-deep bg-primary text-primary-foreground w-full rounded-lg px-4 py-2 text-sm font-semibold transition-colors"
              >
                Zapisz
              </button>
            </form>
          </div>
        ) : (
          <p class="text-muted-foreground text-sm">Tylko właściciel lokalu może edytować te ustawienia.</p>
        )
      }

      <a href="/dashboard" class="text-primary hover:text-bottle-deep mt-4 inline-block text-sm hover:underline"
        >← Powrót do panelu</a
      >
    </div>
  </div>
</Layout>
