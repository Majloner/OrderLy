---
import Layout from "@/layouts/Layout.astro";
import RoomLayoutManager from "@/components/room/RoomLayoutManager";

// Auth + owner role are enforced by middleware (PROTECTED_ROUTES/OWNER_ROUTES),
// so this page only renders the island; it fetches GET /api/room on mount.
// No env props: unlike /menu this slice does not touch Storage.
---

<Layout title="Schemat sali">
  <div class="bg-background text-foreground min-h-screen p-4 sm:p-8">
    <div class="mx-auto w-full max-w-5xl">
      <div class="mb-6 flex items-center justify-between">
        <h1 class="font-display text-primary text-3xl font-bold">Schemat sali</h1>
        <a href="/dashboard" class="text-primary hover:text-bottle-deep text-sm hover:underline">← Powrót do panelu</a>
      </div>
      <RoomLayoutManager client:load />
    </div>
  </div>
</Layout>
