---
import Layout from "@/layouts/Layout.astro";
import RoomLayoutManager from "@/components/room/RoomLayoutManager";

// Auth + owner role are enforced by middleware (PROTECTED_ROUTES/OWNER_ROUTES),
// so this page only renders the island; it fetches GET /api/room on mount.
// No env props: unlike /menu this slice does not touch Storage.
---

<Layout title="Schemat sali">
  <div class="bg-cosmic min-h-screen p-4 text-white sm:p-8">
    <div class="mx-auto w-full max-w-5xl">
      <div class="mb-6 flex items-center justify-between">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Schemat sali
        </h1>
        <a href="/dashboard" class="text-sm text-purple-300 hover:underline">← Powrót do panelu</a>
      </div>
      <RoomLayoutManager client:load />
    </div>
  </div>
</Layout>
