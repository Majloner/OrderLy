---
import Layout from "@/layouts/Layout.astro";
import StaffManager from "@/components/staff/StaffManager";

// Auth + owner role are enforced by middleware (PROTECTED_ROUTES/OWNER_ROUTES),
// so this page only renders the island; it fetches GET /api/staff on mount.
// The user id is passed so the owner's own row can disable the controls the API
// and the profiles_guard_self_change trigger would reject.
const { user, company_id, supabase } = Astro.locals;

// The owner cannot tell staff a code they cannot see. Read server-side rather
// than adding it to the staff payload — it belongs to the company, not to any
// one row. No top-level `return` here; it trips an eslint/astro bug.
let venueCode: string | null = null;
if (supabase && company_id) {
  const { data } = await supabase.from("companies").select("code").eq("id", company_id).maybeSingle<{ code: string }>();
  venueCode = data?.code ?? null;
}
---

<Layout title="Pracownicy">
  <div class="bg-background min-h-screen p-4 text-white sm:p-8">
    <div class="mx-auto w-full max-w-3xl">
      <div class="mb-6 flex items-center justify-between">
        <h1 class="font-display text-primary text-3xl font-bold">Pracownicy</h1>
        <a href="/dashboard" class="text-sm text-purple-300 hover:underline">← Powrót do panelu</a>
      </div>

      {
        venueCode && (
          <div class="mb-6 rounded-xl border border-white/10 bg-white/5 px-4 py-3">
            <p class="text-sm text-blue-100/70">
              Kod lokalu:
              <span class="ml-2 font-mono text-lg font-semibold tracking-widest text-white">{venueCode}</span>
            </p>
            <p class="mt-1 text-xs text-white/50">
              Pracownik podaje ten kod razem ze swoim loginem przy logowaniu. Kod jest stały i nie zmienia się.
            </p>
          </div>
        )
      }

      <StaffManager client:load currentUserId={user?.id ?? ""} />
    </div>
  </div>
</Layout>
